# Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com suas senhas seguras
# NUNCA commite o arquivo .env no git!
#
# Como usar:
# 1. Copie este arquivo: cp env.example .env
# 2. Edite o .env e preencha com suas senhas seguras
# 3. O docker-compose.yml irá carregar automaticamente as variáveis do .env

# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS POSTGRESQL
# ============================================
# Host do banco de dados (use 'database' para Docker, 'localhost' para local)
DB_HOST=database

# Usuário administrador do PostgreSQL
DB_ADMIN_USER=postgres

# ⚠️ ALTERE ESTA SENHA PARA UMA SENHA SEGURA!
# Gere uma senha segura usando: openssl rand -base64 24
DB_ADMIN_PW=ALTERE_ESTA_SENHA_PARA_UMA_SEGURA

# ============================================
# CONFIGURAÇÃO DE DOMÍNIO (Produção com HTTPS)
# ============================================
# Seu domínio (exemplo: muonline.exemplo.com)
# Deixe vazio se não estiver usando HTTPS
DOMAIN_NAME=

# ============================================
# CONFIGURAÇÃO DE IP RESOLVER
# ============================================
# Opções:
#   - public: Detecta IP público automaticamente (recomendado para produção)
#   - local: Usa IP local da máquina
#   - loopback: Usa 127.127.127.127 (apenas para testes locais)
#   - ou um IP específico: 192.168.1.100
RESOLVE_IP=public

# ============================================
# CONFIGURAÇÃO DO AMBIENTE .NET
# ============================================
# Ambiente: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# URL do Admin Panel (não altere a menos que saiba o que está fazendo)
ASPNETCORE_URLS=http://+:8080
